<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-section-BP" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Introductory Concepts</title>

<introduction>
 <p> 
    By completing the problems provided below, you will gain practice with: 
    <ul>
      <li>
        <p>
          Identifying sample spaces.
        </p>
      </li>
      <li>
        <p>
          Determining whether outcomes in a sample space are equally likely.
        </p>
      </li>
      <li>
        <p>
          Defining events in terms of the outcomes in a sample space.
        </p>
      </li>
      <li>
        <p>
          Using sample spaces to help you compute probabilities for events.
        </p>
      </li>
    </ul>
  </p>
</introduction>
 
 <!-- Visual Divider ############################################################################################### -->
   <!-- ############################################################################################################## -->


 <exercises xml:id="hw-basic-probability-concepts" >
   <title>Interactive Exercises</title>

   <exercise label="BP-3children">
      <title>Three Children</title>
       <introduction>
         <p>
           Suppose that a couple has three children. We are concerned with the sex of the children at birth. 
         </p>
        </introduction>

      <task>. 
        <statement>
           <p>
             Which option best describes the sample space here?
           </p>
        </statement>

    <choices randomize="yes" >
      <choice correct="yes">
        <statement>
          <p>
            <m> \{BBB, GBB, BGB, BBG, GGB, GBG, BGG, GGG\} </m>
          </p>
        </statement>

        <feedback>
          <p>
            Correct! This set provides a list of all possible outcomes.
          </p>
        </feedback>
      </choice>

      <choice>
        <statement>
          <p>
            <m> \{BBB, GGG, BBG, GGB\} </m>
          </p>
        </statement>

        <feedback>
          <p>
            This option does not take the order of the births into account. 
          </p>
        </feedback>
      </choice>

      <choice>
        <statement>
          <p>
            <m> \{B, G\} </m>
          </p>
        </statement>

        <feedback>
          <p>
            This would be the sample space for the birth of a SINGLE child, not three children.
          </p>
        </feedback>
      </choice>

      <choice>
        <statement>
          <p>
            <m> \{B, G, BG, GB, BBB, GBB, BGB, BBG, GGB, GBG, BGG, GGG\} </m>
          </p>
        </statement>

        <feedback>
          <p>
            This would be the sample space if the couple were to have up to three children, not exactly three children.
          </p>
        </feedback>
      </choice>
    </choices>

   </task>
  
   <!-- ############################################################################################################## -->

   <task>
   
    <statement>
      <p>
        Determine the probability that the second child born will be female. Write your answer as a decimal, accurate to two
        decimal places.
      </p>

      <p>
        <fillin width="8" answer="0.50"/>
      </p>
    </statement>
  
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes"/>
          <feedback>
            <p>
              Correct! Four out of eight outcomes in the sample space involve the second child being female.
            </p>
          </feedback>
        </test>
      
        <test>
        <numcmp min="1.001" max="100"/>
        <feedback>
          <p>
            Probabilities can not be larger than 1.
          </p>
        </feedback>
      </test>
      </evaluate>
    </evaluation>
   </task>
   

   <!-- ############################################################################################################## -->
  

   <task>
    <statement>
      <p>
        Determine the probability that <em>at least</em> the second child will be female. Write your answer as a decimal, accurate to two decimal places.
      </p>

      <p>
        <fillin width="8" answer="0.50"/>
      </p>
    </statement>
  
    <evaluation>
      <evaluate>
        <test correct="yes">
          <numcmp use-answer="yes"/>
          <feedback>
            <p>
              Correct! Four out of eight outcomes in the sample space involve the second child and possibly another child being female.
            </p>
          </feedback>
        </test>
      
        <test>
          <numcmp value="0.375"/>
          <feedback>
            <p>
              Close! Reread the prompt to make sure you are computing the desired probability.
            </p>
          </feedback>
        </test>

        <test>
          <numcmp min="1.001" max="100"/>
          <feedback>
            <p>
              Probabilities can not be larger than 1.
            </p>
          </feedback>
        </test>
      </evaluate>
    </evaluation>
    </task>
   </exercise>

  


 <!-- Visual Divider ############################################################################################### -->
 <!-- ############################################################################################################## -->


   
   <exercise label="BP-blood-type">
     <title>Blood Type</title>

     <introduction>
       <p>
         An experiment consists of randomly selecting a person and recording their blood type, which could be A, B, AB, or O, and the status of their Rhesus (Rh) factor, which is either present (+) or not (-).
       </p>
     </introduction>

<task>
  <statement>
    <p>
      Define the sample space for this experiment by dragging relevant outcomes to the right.
    </p>
  </statement>

     <feedback>
       <p>
        
       </p>
     </feedback>

     <cardsort>
       <match>
         <premise order="3">A+</premise>
         <premise order="3">A-</premise>
         <premise order="3">B-</premise>
         <premise order="3">B+</premise>
         <premise order="3">AB-</premise>
         <premise order="3">AB+</premise>
         <premise order="3">0-</premise>
         <premise order="3">0+</premise>
         <response>Sample Space <m>S=\{  \quad \quad   \}</m></response>
       </match>
       <match>
         <premise order="2">(+)</premise>
         <premise order="2">(-)</premise>
         <premise order="1">A</premise>
         <premise order="1">B</premise>
         <premise order="1">AB</premise>
         <premise order="1">O</premise>
       </match>
     </cardsort>
   </task>


   <!-- ############################################################################################################## -->

   <task>

     <statement correct="no">
       <p>
          All outcomes in the sample space are equally likely.
       </p>
     </statement>

     <feedback>
       <p>
         Are some blood types less common than others? Yes! For example, Rh-present (+) blood types are much more common than Rh-negative (-) blood types. 
       </p>
     </feedback>
     </task>
   </exercise>


 <!-- Visual Divider ############################################################################################### -->
   <!-- ############################################################################################################## -->

<exercise label="ex-probability-streaming-experiment" xmlns:pi="http://pretextbook.org">
    <title>Streaming Movies and TV</title>
    <introduction>
        <p>
            Your professor wants to watch something but cannot decide on what. So, she first tosses a fair coin to choose a streaming platform. If the coin lands heads, she will log into Netflix (<m>N</m>); if it lands tails, she will log into Hulu (<m>H</m>). 
        </p>
        <p>
            Once logged in, she randomly selects content (e.g., tv show, movie, etc):
            <ul>
                <li><p>If she is on Netflix, she will choose randomly between a movie (<m>M</m>) or a documentary (<m>D</m>).</p></li>
                <li><p>If she is on Hulu, she will choose randomly between a comedy show (<m>C</m>), an anime series (<m>A</m>), or a reality TV episode (<m>R</m>).</p></li>
            </ul>
            The "experiment" is to observe the combination of the streaming platform and specific content type chosen.
        </p>
    </introduction>
    <task xml:id="task-streaming-space-id">
        <statement>
            <p>
                Which of the following sets correctly describes the full sample space <m>S</m> for this experiment?
            </p>
        </statement>
        <choices randomize="yes">
            <choice>
                <statement><p><m> \{(N, M), (N, D), (H, C), (H, A)\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This subset leaves out the outcome <m>(H, R)</m> for watching a reality TV episode on Hulu. A complete sample space must list every possible outcome.</p>
                </feedback>
            </choice>
            <choice>
                <statement><p><m> \{(N, M), (N, D), (N, C), (N, A), (N, R), (H, M), (H, D), (H, C), (H, A), (H, R)\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This list includes outcomes that are not possible! For example, she will not select a comedy show on Netflix.</p>
                </feedback>
            </choice>
            <choice correct="yes">
                <statement><p><m> \{(N, M), (N, D), (H, C), (H, A), (H, R)\}</m></p></statement>
                <feedback>
                    <p>Correct!  This set contains all 5 possible outcomes.</p>
                </feedback>
            </choice>
            <choice>
                <statement><p><m> \{N, H, M, D, C, A, R\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This is a list of individual choices rather than combinations. The "experiment" is to observe the combination of the streaming platform AND specific content type chosen.</p>
                </feedback>
            </choice>
            <choice>
                <statement><p><m> \{(N, H), (M, D), (C, A, R)\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This lists groupings of the possible individual choices, rather than the possible combinations of streaming platform AND content.</p>
                </feedback>
            </choice>
        </choices>
    </task>


   <!-- ############################################################################################################## -->
    <task xml:id="task-streaming-event-subset">
        <statement>
            <p>
                 Let <m>E</m> be the event that the professor chooses to watch a fictional scripted story (defined here as a movie, a comedy show, or an anime series). Which subset correctly defines the event  <m>E</m>?
            </p>
        </statement>
        <choices randomize="yes">
            <choice><statement><p><m> \{M, C, A\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This list contains only the individual content options. <m>E</m> should be a subset of outcomes from the sample space.</p>
                </feedback></choice>
            <choice correct="yes"><statement><p><m>\{(N, M), (H, C), (H, A)\}</m></p></statement>
                <feedback>
                    <p>Correct! The subset <m>E</m> filters the total sample space <m>S</m> to capture only the outcomes matching our event definition.
                    </p>
                </feedback></choice>
            <choice><statement><p><m>\{(N, M), (N, D), (H, C), (H, A), (H, R)\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This is the entire sample space <m>S</m>, but not all outcomes in the sample space belong to event <m>E</m>. 
                    </p>
                </feedback></choice>
            <choice><statement><p><m> \{(H, C), (H, A)\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This subset is missing an outcome: the movie on Netflix.</p>
                </feedback></choice>
            <choice><statement><p><m>\{N, D), (H, R)\}</m></p></statement>
                <feedback>
                    <p>Incorrect. This subset captures the exact opposite of event <m>E</m>!</p>
                </feedback></choice>
        </choices>
    </task>
    
 <!-- ############################################################################################################## -->
<task xml:id="task-streaming-likelihood-mc">
        <statement correct="no">
       <p>
          All outcomes in the sample space are equally likely.
       </p>
     </statement>

     <feedback>
       <p>
         The multi-stage structure of the experiment affects the probabilities of the sample space outcomes. After the initial coin flip, there are different numbers of subsequent choices. 
       </p>
     </feedback>
       
    </task>
</exercise>


  </exercises>


