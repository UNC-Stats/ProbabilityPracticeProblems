<exercises xml:id="hw-basic-probability-concepts-turn-in" >
   <title>Written Exercises</title>
   <introduction>
     <p>
       Write intro to written part of homework set.....
     </p>
   </introduction>

<exercise label="ex-library-books">
<title>Library Books</title>

<introduction>
  <p>
    A library has five copies of a popular textbook. Two of the
    copies have missing pages, while the remaining three are in good condition.
    A student requests two copies of the textbook, and the librarian fulfills the requests by randomly selecting two from the five available.
  </p>

  <p>
    Label the damaged books <m>D_1</m> and <m>D_2</m>, and label the books in
    good condition <m>G_1</m>, <m>G_2</m>, and <m>G_3</m>.
  </p>
</introduction>

  <task>
  <statement>
    <p>
      List the sample space for this experiment.
    </p>
  </statement>
  </task>

  <task>
  <statement>
    <p>
      Determine the probability that the student receives two books that are in good
    condition.
    </p>
  </statement>
  </task>
</exercise>

</exercises>
</section>