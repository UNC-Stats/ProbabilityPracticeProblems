<exercises xml:id="hw-basic-probability-concepts-turn-in" >
   <title>Written Exercises</title>
   

<exercise label="ex-library-books">
<title>Library Books</title>

<introduction>
  <p>
    The university library has five copies of a popular textbook. Two of the
    copies have missing pages, while the remaining three are in good condition.
    A student requests two copies of the textbook, and the librarian on duty randomly selects two of the five available to check-out to the student.
  </p>

  <p>
    Let <m>D_1</m> and <m>D_2</m> represent the damaged textbooks, and let <m>G_1</m>, <m>G_2</m>, and <m>G_3</m> represent the textbooks that are in good condition.
  </p>
</introduction>

  <task>
  <statement>
    <p>
      List the sample space for this experiment.
    </p>
  </statement>
  </task>

  <task>
  <statement>
    <p>
      Determine the probability that the student receives two books that are in good
    condition.
    </p>
  </statement>
  </task>
</exercise>

</exercises>
</section>