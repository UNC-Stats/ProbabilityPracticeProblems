   <!-- ############################################################################################################## -->


<exercise label="counting-scaffolded-exam-probability">
    <title>Exam Preparation</title>
    <introduction>
        <p>
            A student prepares for an upcoming probability exam by studying a master list of 10 complex problems. She successfully learns how to solve 6 of the problems. For the actual exam, the instructor selects 5 problems at random from the master list of 10 problems. 
        </p>
    </introduction>

    <!-- Part A: Total Sample Space -->
    <task xml:id="task-exam-scaffold-total-space">
        <statement>
            
            <p>
                Calculate the total number of possible exams. Or in other words, calculate the number of ways that the instructor can select 5   of the 10 problems on the master list. Enter your answer as a whole number.
            </p>
            <p>
                Total Exams = <fillin answer="252" width="8"/> 
            </p>
        </statement>
        <evaluation>
            <evaluate><test correct="yes"><numcmp use-answer="yes"/>
                    <feedback>
            <p>
                Because the order in which the instructor selects the questions on the exam paper does not matter, we use a combination:
                <me>\binom{10}{5} = \frac{10 \cdot 9 \cdot 8 \cdot 7 \cdot 6}{5 \cdot 4 \cdot 3 \cdot 2 \cdot 1} = 252</me>
            </p>
        </feedback>
        </test></evaluate>
        </evaluation>

    </task>
   <!-- ############################################################################################################## -->
    <!-- Part B: Favorable Outcome Space -->
    <task xml:id="task-exam-scaffold-favorable-space">
        <statement>
            <p>
                Calculate the total number of ways the instructor can choose 5 problems such that they all come from the pool of 6 problems that the student knows how to solve. Enter your answer as a whole number.
            </p>
            <p>
                Total Favorable Exams = <fillin answer="6" width="8"/> 
            </p>
        </statement>
        <evaluation>
            <evaluate><test correct="yes"><numcmp use-answer="yes"/>
                 <feedback>
            <p>
                We restrict our selection to the 6 problems the student can answer and count the ways to select 5 of them:
                <me>\binom{6}{5} = 6</me>
            </p>
        </feedback>
            </test></evaluate>
        </evaluation>
   
    </task>
   <!-- ############################################################################################################## -->
    <!-- Part C: Final Probability Mapping -->
    <task xml:id="task-exam-scaffold-probability-mc">
        <statement>

            <p>
                Using your answers from parts (a) and (b), determine the probability that the student can solve all five of the problems on her probability exam.
            </p>
        </statement>
        <choices randomize="yes">
            <choice correct="yes">
                <statement><p><m>\frac{1}{42} \approx 0.0238</m> </p></statement>
                <feedback>
                    <p>Correct! Divide the number of favorable exams by the total number of possible exams: <me>P(X = 5) = \frac{\binom{6}{5}}{\binom{10}{5}} = \frac{6}{252} = \frac{1}{42} \approx 0.0238</me>.</p>
                </feedback>
            </choice>
            <choice>
                <statement><p><m>\frac{1}{252} \approx 0.0040</m> </p></statement>
                <feedback>
                    <p>Incorrect. Check the numerator! There is more than one favorable exam. The denominator is correct. </p>
                </feedback>
            </choice>
            <choice>
                <statement><p><m>\frac{6}{10} \approx 0.6000</m> </p></statement>
                <feedback>
                    <p>Incorrect. This would be the probability that, for the first and only problem on the exam, the instructor selects one of the six problems that the student can answer. </p>
                </feedback>
            </choice>
            <choice>
                <statement><p><m>\frac{5}{6} \approx 0.8333</m> </p></statement>
                <feedback>
                    <p>Incorrect. This answer is just the ratio of exam questions to the number of questions the student can answer, which is not what we want.</p>
                </feedback>
            </choice>
        </choices>
    </task>
  
</exercise>

 </exercises>



