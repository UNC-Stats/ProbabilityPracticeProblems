   <!-- ############################################################################################################## -->
 
<exercise label="counting-simple-committee-seating">
    <title>Committee Seating Arrangements</title>
    <introduction>
        <p>
            Eight committee members are meeting in a room that has twelve chairs.
        </p>
    </introduction>

    <!-- Part 1: Combinations (Choosing the chairs) -->
    <task>
        <statement>
            <p>
                In how many ways can the group choose which <m>8</m> chairs will be occupied, if we do not care yet who sits in which chair?
            </p>
        </statement>
        <choices randomize="yes">
            <choice correct="yes">
                <statement><m>\binom{12}{8} = 495</m> ways</statement>
                <feedback>
                    <p>
                        Correct! Since the arrangement or order in which people sit does not matter, we use a combination.
                    </p>
                </feedback>
            </choice>
            <choice>
                <statement><m>_{12}P_8 = 19,958,400</m> ways</statement>
                <feedback>
                    <p>
                        Incorrect. This counts the number of ways to assign specific people to specific chairs, but order does not matter here.
                    </p>
                </feedback>
            </choice>
            <choice>
                <statement><m>12 \times 8 = 96</m> ways</statement>
                <feedback>
                    <p>
                        Incorrect. This answer applies the multiplication rule incorrectly.
                    </p>
                </feedback>
            </choice>
            <choice>
                <statement><m>8! = 40,320</m> ways</statement>
                <feedback>
                    <p>
                        Incorrect. This is the number of ways to arrange the 8 people in 8 chairs, but order does not matter here. Also, this answer does not account for the fact that we have to choose 8 chairs from the available 12.
                    </p>
                </feedback>
            </choice>
        </choices>
    </task>

   <!-- ############################################################################################################## -->
    <!-- Part 2: Permutations (Assigning people to chairs) -->
    <task>
        <statement>
            <p>
                In how many ways distinct ways can the <m>8</m> committee members actually sit down in the <m>12</m> available chairs?
            </p>
        </statement>
        <choices randomize="yes">
            <choice correct="yes">
                <statement><m>_{12}P_8 = 19,958,400</m> ways</statement>
                <feedback>
                    <p>
                        Correct! Order matters here, so we use a permutation.
                    </p>
                </feedback>
            </choice>
            <choice>
                <statement><m>\binom{12}{8} = 495</m> ways</statement>
                <feedback>
                    <p>
                        Incorrect. This only selects which chairs are used, it does not take seating order into account.
                    </p>
                </feedback>
            </choice>
            <choice>
                <statement><m>12^8 = 429,981,696</m> ways</statement>
                <feedback>
                    <p>
                        Incorrect. This would allow multiple committee members to sit in the same chair! 
                    </p>
                </feedback>
            </choice>
            <choice>
                <statement><m>8! = 40,320</m> ways</statement>
                <feedback>
                    <p>
                        Incorrect. This is the number of ways to arrange the 8 people in 8 chairs, but it does not account for the fact that we have to choose 8 chairs from the available 12.
                    </p>
                </feedback>
            </choice>
        </choices>
    </task>
</exercise>


