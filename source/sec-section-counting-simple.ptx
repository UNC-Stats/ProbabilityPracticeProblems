   <exercise label="Count-simple-Korean-BBQ">
      <title>Korean BBQ</title>

      <introduction>
        <p>
          Your professor went to Suh Sushi Korean BBQ in Fort Collins, CO for Valentine's Day. The restaurant offered a special where a couple could choose one appetizer, two entrees, one dessert, and two drinks.
        </p>
      </introduction>

      <task>
        <statement>
          <p>
              How many different shared dinners were available if a couple could choose between six appetizers, fourteen entrees, three desserts, and three drinks.
          </p>
        </statement>


      <choices randomize="yes" multiple-correct="yes">
         <choice correct="yes">
            <statement>
              <p>
                <m> 31752 </m>
              </p>
            </statement>

            <feedback>
              <p>
                Correct! 
              </p>
            </feedback>
          </choice>

          <choice>
           <statement>
             <p>
               <m> 756 </m>
             </p>
           </statement>

           <feedback>
             <p>
                Close! Make sure each person gets a drink and entree while counting. 
             </p>
           </feedback>
         </choice>

         <choice>
           <statement>
              <p>
                <m> 19656 </m>
              </p>
           </statement>

           <feedback>
             <p>
               Are there any rules saying the couple has to order different items from each other?
             </p>
           </feedback>
         </choice>

         <choice>
           <statement>
             <p>
               <m> 571536 </m>
             </p>
           </statement>

           <feedback>
             <p>
               This answer includes ordering too many items. Check the special again.
            </p>
           </feedback>
         </choice>
      </choices>
   </task>

 <!-- Visual Divider ############################################################################################### -->
   <!-- ############################################################################################################## -->

   <task>

      <statement>
         <p> 
            For the entrees, a couple can choose between BBQ meals and there are five choices for meats (galbi, beef bulgogi, beef brisket, pork belly, pork bulgogi) and specialty sushi rolls (there are 9 rolls: rainbow, dragon, french kiss, rose, unagi bomb, golden tiger, diablo, tropical, veggie kimbap). How many shared dinners are possible if a couple specifically wants to order one BBQ meal and one specialty roll?
         </p>
             
          <p>
            <fillin width="8" answer="2430"/>
          </p>
      </statement>
  
      <evaluation>
         <evaluate>
           <test correct="yes">
             <numcmp use-answer="yes"/>
             <feedback>
               <p>
                Correct! 
               </p>
             </feedback>
           </test>
          
           <test>
             <numcmp value="45"/>
              <feedback>
                <p>
                  This answer only counts entrees, rather than the entire shared meal.
                </p>
              </feedback>
            </test>
        
         </evaluate>
      </evaluation>
   </task>
</exercise>

