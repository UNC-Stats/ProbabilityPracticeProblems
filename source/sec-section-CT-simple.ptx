<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-section-CT-simple" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Practice Each Counting Technique</title>

  <p> 
  </p>

 <exercises xml:id="hw-counting-simple-KoreanBBQ-dinner" >
    <title>Korean BBQ</title>
    <introduction>
      <p>
        Your professor went to Suh Sushi Korean BBQ in Fort Collins, CO for Valentine's Day. The restaurant offered a special where a couple could choose one appetizer, two entrees, one dessert, and two drinks.
      </p>
    </introduction>
   
   <exercise label="CT-simple-MCR-Sample-Space-Size-Korean-BBQ">
      <title>Size of Sample Space</title>
      <statement>
        <p>
          How many different shared dinners were available if a couple could choose between six appetizers, fourteen entrees, three desserts, and three drinks.
       </p>
      </statement>

      <choices randomize="yes" multiple-correct="yes">
         <choice correct="yes">
            <statement>
              <p>
                <m> 31752 </m>
              </p>
            </statement>

            <feedback>
              <p>
                Correct! 
              </p>
            </feedback>
          </choice>

          <choice>
           <statement>
             <p>
               <m> 756 </m>
             </p>
           </statement>

           <feedback>
             <p>
                Close! Make sure each person gets a drink and entree while counting. 
             </p>
           </feedback>
         </choice>

         <choice>
           <statement>
              <p>
                <m> 19656 </m>
              </p>
           </statement>

           <feedback>
             <p>
               Are there any rules saying the couple has to order different items from each other?
             </p>
           </feedback>
         </choice>

         <choice>
           <statement>
             <p>
               <m> 571536 </m>
             </p>
           </statement>

           <feedback>
             <p>
               This answer includes ordering too many items. Check the special again.
            </p>
           </feedback>
         </choice>
      </choices>
   </exercise>


   <exercise label="CT-simple-MCR-Sample-Space-Size-B-Korean-BBQ">
      <title>Size of Sample Space</title>

      <statement>
         <p> 
            For the entrees, a couple can choose between BBQ meals and there are five choices for meats (galbi, beef bulgogi, beef brisket, pork belly, pork bulgogi) and specialty sushi rolls (there are 9 rolls: rainbow, dragon, french kiss, rose, unagi bomb, golden tiger, diablo, tropical, veggie kimbap). How many shared dinners are possible if a couple specifically wants to order one BBQ meal and one specialty roll?
         </p>
             
          <p>
            <fillin width="8" answer="2430"/>
          </p>
      </statement>
  
      <evaluation>
         <evaluate>
           <test correct="yes">
             <numcmp use-answer="yes"/>
             <feedback>
               <p>
                Correct! 
               </p>
             </feedback>
           </test>
          
           <test>
             <numcmp value="45"/>
              <feedback>
                <p>
                  This answer only counts entrees, rather than the entire shared meal.
                </p>
              </feedback>
            </test>
        
         </evaluate>
      </evaluation>
   </exercise>


 </exercises>
 
 <exercises xml:id="hw-counting-simple-5x6-array" >
    <title>5-by-6 Array</title>
    <introduction>
      <p>
        Your professor went to Suh Sushi Korean BBQ in Fort Collins, CO for Valentine's Day. The restaurant offered a special where a couple could choose one appetizer, two entrees, one dessert, and two drinks.
      </p>
    </introduction>
   
   <exercise label="CT-simple-MCR-5x6-array">
      <title>Counting</title>
      <statement>
        <p>
          Thirty items are arranged in a 5-by-6 array as shown below. Calculate the number of ways to form a set of three distinct items such that no two of the selected items are in the same row or same column.
       </p>

       <image source="Images/5x6-array.png" width="60%"/>
      </statement>

      <choices randomize="yes" multiple-correct="yes">
         <choice correct="yes">
            <statement>
              <p>
                <m> 1200 </m>
              </p>
            </statement>

            <feedback>
              <p>
                Correct! 
              </p>
            </feedback>
          </choice>

          <choice>
           <statement>
             <p>
               <m> 2000 </m>
             </p>
           </statement>

           <feedback>
             <p>
                
             </p>
           </feedback>
         </choice>

         <choice>
           <statement>
              <p>
                <m> 4060 </m>
              </p>
           </statement>

           <feedback>
             <p>
               
             </p>
           </feedback>
         </choice>

         <choice>
           <statement>
             <p>
               <m> 6000 </m>
             </p>
           </statement>

           <feedback>
             <p>
               
            </p>
           </feedback>
         </choice>

         <choice>
           <statement>
             <p>
               <m> 7200 </m>
             </p>
           </statement>

           <feedback>
             <p>
               
            </p>
           </feedback>
         </choice>
      </choices>
   </exercise>





 </exercises>

</section>